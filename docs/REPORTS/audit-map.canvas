    {"id":"6f9c2d5e8b1a4370","fromNode":"a45c0d7e2b9f6318","fromSide":"bottom","toNode":"74c1f09a6d2e835b","toSide":"top","toEnd":"arrow","label":"after slice"},
    {"id":"7a0d3e6f9c2b5481","fromNode":"6f0a2e8d1c9b3475","fromSide":"bottom","toNode":"74c1f09a6d2e835b","toSide":"right","toEnd":"arrow","label":"choose then integrate"},
    {"id":"8b1e4f7a0d3c6592","fromNode":"2a8c5e1f0d7b4396","fromSide":"bottom","toNode":"e3a17c9d5f2046b8","toSide":"left","toEnd":"arrow","label":"quality plan"},
    {"id":"9c2f5a8b1e4d7603","fromNode":"3e8b1a6d4f902c75","fromSide":"left","toNode":"e3a17c9d5f2046b8","toSide":"right","toEnd":"arrow","label":"verify"},
    {"id":"ad3c6f9b2e5a8174","fromNode":"a45c0d7e2b9f6318","fromSide":"left","toNode":"e3a17c9d5f2046b8","toSide":"right","toEnd":"arrow","label":"CI gates"}
  ]
