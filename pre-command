#!/usr/bin/env bash
# Buildkite pre-command hook
# Runs before each step to set up environment

set -euo pipefail

echo "--- :wrench: Buildkite Pre-Command Hook"

# Install Rust if not present
if ! command -v cargo &> /dev/null; then
    echo "Installing Rust..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.98.1
    source "$HOME/.cargo/env"
fi

# Ensure correct Rust version
rustup default 1.98.1
rustup component add rustfmt clippy 2>/dev/null || true

# Cache cargo registry
export CARGO_HOME="${BUILDKITE_BUILD_CHECKOUT_PATH}/.cargo"
export CARGO_TARGET_DIR="${BUILDKITE_BUILD_CHECKOUT_PATH}/target"

# Godot setup
if command -v godot &> /dev/null; then
    echo "Godot version: $(godot --version)"
else
    echo "Godot not found in PATH"
fi

# Protobuf
if ! command -v protoc &> /dev/null; then
    echo "Installing protoc..."
    apt-get update && apt-get install -y protobuf-compiler 2>/dev/null || true
fi

echo "Environment ready"