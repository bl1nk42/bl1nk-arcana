[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
CardDatabase="*res://scripts/autoload/CardDatabase.gd"
DataRegistry="*res://scripts/autoload/DataRegistry.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
SettingsManager="*res://scripts/autoload/SettingsManager.gd"
; NOTE: this autoload used to be called GDExtensionManager. Godot 4.3 ships a
; native engine class with that exact name, and GDScript resolves the native
; class first, so every call to the autoload failed to parse. Do not rename back.
RustCore="*res://scripts/autoload/RustCore.gd"
ClassDatabase="*res://scripts/autoload/ClassDatabase.gd"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0

[layer_names]

2d_physics/layer_1="units"
2d_physics/layer_2="terrain"
2d_physics/layer_3="projectiles"
2d_physics/layer_4="effects"
2d_render/layer_1="background"
2d_render/layer_2="terrain"
2d_render/layer_3="units"
2d_render/layer_4="effects"
2d_render/layer_5="ui"

[resource_loader]

cache_mode=1

[gdextension]

; GDExtension will be loaded via blink_core.gdextension manifest