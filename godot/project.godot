; Engine configuration file for Blink Arcana
; Generated by Godot 4.7

[application]

config/name="Blink Arcana"
config/icon="res://assets/ui/icon.svg"
run/main_scene="res://scenes/battle/BattleScene.tscn"
config/features=PackedStringArray("4.3", "mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/size/fullscreen_mode=2
window/vsync_mode=1
window/title="Blink Arcana"

[rendering]

renderer/rendering_method="mobile"
rendering_2d/batching/use_batching=true
rendering_2d/batching/single_rect_fallback=true
rendering_2d/batching/max_join_item_commands=400
rendering_2d/batching/max_join_items=400
rendering_2d/batching/flush_threshold=1.0

