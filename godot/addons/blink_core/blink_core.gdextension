[configuration]

; godot-rust 0.5 exports "gdext_rust_init". The old godot-rust 0.1/0.2 name
; was "gdextension_init", which no longer exists in the built library.
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/blink_core/bin/libblink_gdext.so"
linux.release.x86_64 = "res://addons/blink_core/bin/libblink_gdext.so"
windows.debug.x86_64 = "res://addons/blink_core/bin/blink_gdext.dll"
windows.release.x86_64 = "res://addons/blink_core/bin/blink_gdext.dll"
macos.debug.x86_64 = "res://addons/blink_core/bin/libblink_gdext.dylib"
macos.release.x86_64 = "res://addons/blink_core/bin/libblink_gdext.dylib"
macos.debug.arm64 = "res://addons/blink_core/bin/libblink_gdext.dylib"
macos.release.arm64 = "res://addons/blink_core/bin/libblink_gdext.dylib"
android.debug.x86_64 = "res://addons/blink_core/bin/libblink_gdext.so"
android.release.x86_64 = "res://addons/blink_core/bin/libblink_gdext.so"
android.debug.arm64 = "res://addons/blink_core/bin/libblink_gdext.so"
android.release.arm64 = "res://addons/blink_core/bin/libblink_gdext.so"
web.debug.wasm32 = "res://addons/blink_core/bin/blink_gdext.wasm"
web.release.wasm32 = "res://addons/blink_core/bin/blink_gdext.wasm"

[dependencies]

; No external GDExtension dependencies